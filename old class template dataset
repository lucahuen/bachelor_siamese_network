        assert strategy in [None, "RANDOM", "DISTANT"], "strategy must be RANDOM or DISTANT"

        root_dir = "data/RVL_CDIP/images"
        label_file = "data/RVL_CDIP/labels/val.txt"

        self.all_image_paths = []
